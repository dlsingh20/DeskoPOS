# Copy to .env (or set in Railway) - never commit real values
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
DEBUG=false
ALLOWED_HOSTS=api.appdesko.com
# Empty in development: an embedded PostgreSQL starts in .pgdata/
DATABASE_URL=postgres://pos_owner:password@host:5432/pos
CORS_ALLOWED_ORIGINS=https://pos.appdesko.com,https://admin.appdesko.com
# Cloudflare Turnstile secret; empty = captcha not checked
TURNSTILE_SECRET=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=AppDesko POS <no-reply@appdesko.com>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
