# Settings for a DeskoPOS app build. Copy to .env.production.local (not committed) and fill in.

# DeskoPOS service address (required)
REACT_APP_API_BASE_URL=https://api.example.com

# Cloudflare Turnstile site key for the sign-in captcha. Leave empty for no captcha;
# set it together with TURNSTILE_SECRET on the service.
REACT_APP_TURNSTILE_SITEKEY=

# Guest ordering page that table QR codes open. Leave empty: DeskoPOS has none yet,
# so table QR codes are hidden.
REACT_APP_GUEST_APP_URL=
